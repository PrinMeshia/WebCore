layout DocsLayout {
    header class="site-header" {
        button class="icon-btn mobile-toggle" aria-label="Toggle navigation" {
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" {
                path d="M4 6h16" {}
                path d="M4 12h16" {}
                path d="M4 18h16" {}
            }
        }
        link to="/" class="brand" {
            span class="mark" { "W" }
            span { "WebCore" }
        }
        nav class="header-nav" {
            link to="/docs" { "Docs" }
            link to="/docs/syntax" { "Reference" }
            link to="/docs/examples" { "Examples" }
            a href="https://github.com/PrinMeshia/Webcore" { "GitHub" }
        }
        span class="header-spacer" {}
        div class="header-actions" {
            button class="search-btn" aria-label="Search" {
                svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" {
                    circle cx="11" cy="11" r="7" {}
                    path d="m21 21-4.3-4.3" {}
                }
                span class="txt" { "Search docs…" }
                span class="kbd" { "⌘K" }
            }
            button class="icon-btn theme-toggle" aria-label="Toggle theme" {
                svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {
                    circle cx="12" cy="12" r="4" {}
                    path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" {}
                }
                svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {
                    path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" {}
                }
            }
        }
    }

    div class="layout" {
        aside class="sidebar" {
            nav class="sidebar-group" {
                p class="group-title" { "Getting Started" }
                link to="/docs" { "Introduction" }
                link to="/docs/installation" { "Installation" }
                link to="/docs/first-app" { "Your first app" }
            }
            nav class="sidebar-group" {
                p class="group-title" { "Core concepts" }
                link to="/docs/components" { "Components & state" }
                link to="/docs/templating" { "Templating & directives" }
                link to="/docs/styling" { "Styling" }
                link to="/docs/routing" { "Routing & pages" }
                link to="/docs/data" { "Data & content" }
                link to="/docs/reactivity" { "Reactivity" }
            }
            nav class="sidebar-group" {
                p class="group-title" { "Guides" }
                link to="/docs/i18n" { "Internationalization" }
                link to="/docs/seo" { "SEO & metadata" }
                link to="/docs/islands" { "Islands" }
                link to="/docs/forms" { "Forms & validation" }
            }
            nav class="sidebar-group" {
                p class="group-title" { "Reference" }
                link to="/docs/syntax" { "Syntax" }
                link to="/docs/cli" { "CLI" }
                link to="/docs/config" { "Configuration" }
                link to="/docs/functions" { "Native functions" }
            }
            nav class="sidebar-group" {
                p class="group-title" { "Resources" }
                link to="/docs/examples" { "Examples" }
                link to="/docs/playground" { "Playground" }
                a href="https://github.com/PrinMeshia/Webcore/blob/main/CHANGELOG.md" { "Changelog" }
            }
        }

        main class="content" {
            div class="content-inner prose" {
                slot content
            }
        }

        aside class="toc" {
            p class="toc-title" { "On this page" }
            nav class="toc-list" {}
        }
    }

    footer class="site-footer" {
        p {
            "Built with "
            strong { "WebCore" }
            " · "
            a href="https://github.com/PrinMeshia/Webcore" { "GitHub" }
            " · "
            a href="https://github.com/PrinMeshia/Webcore/releases" { "Releases" }
            " · "
            a href="https://github.com/PrinMeshia/Webcore/blob/main/CHANGELOG.md" { "Changelog" }
        }
    }

    div class="cmdk" {
        div class="cmdk-box" {
            input class="cmdk-input" type="text" placeholder="Search the docs…" autocomplete="off" spellcheck="false" {}
            div class="cmdk-results" {}
        }
    }

    DocsShell {}
}
